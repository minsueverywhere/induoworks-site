# Copy to .dev.vars for local `wrangler pages dev` testing.
# .dev.vars is gitignored — never commit real secrets.
# In production these are set as encrypted Environment Variables in the
# Cloudflare Pages dashboard (Settings → Environment variables), not here.

RESEND_API_KEY=
CONTACT_TO_EMAIL=
# For production, this must use a domain already verified in Resend.
# onboarding@resend.dev only works when CONTACT_TO_EMAIL is the email address
# associated with the Resend account.
CONTACT_FROM_EMAIL=
TURNSTILE_SECRET_KEY=
