    {
      "slug": "induoworks-site",
      "year": "2026",
      "stack": [
        "Astro",
        "Tailwind CSS",
        "Cloudflare Workers"
      ],
      "kind": "site",
      "status": "shipped",
      "href": "https://induo.works",
      "repo": "https://github.com/minsueverywhere/induoworks-site",
      "featured": true,
      "workerIds": [
        "induo-works"
      ],
      "title": {
        "en": "Induo Works Site",
        "ko": "Induo Works 웹사이트"
      },
      "summary": {
        "en": "A small village of independent creators, with workshops to visit and work to discover.",
        "ko": "독립 창작자들의 작은 마을입니다. 작업실을 둘러보고 게임과 아트워크를 만나보세요."
      },
      "role": {
        "en": "Design & build",
        "ko": "설계 및 개발"
      },
      "challenge": {
        "en": "Make discovering creators and their work feel like exploring a village, on phones, tablets and computers.",
        "ko": "휴대폰, 태블릿, PC에서 마을을 탐험하듯 창작자와 작업물을 발견할 수 있는 공간을 만듭니다."
      },
      "approach": {
        "en": "Astro serves static pages. A lightweight Canvas village supports drag, pinch and wheel zoom, with an optional hands-on tutorial. Works offers searchable views, and the village and Workers share creator data. Artwork originals load only when requested.",
        "ko": "Astro의 정적 페이지에 가벼운 Canvas 마을을 더했습니다. 드래그·핀치·휠로 둘러보고 짧은 튜토리얼을 체험할 수 있습니다. Works에서 검색과 보기 방식을 선택하며, 마을과 Workers는 제작자 정보를 공유합니다. 고용량 아트워크 원본은 요청할 때만 불러옵니다."
      },
      "outcome": {
        "en": "Live in Korean and English, with light and dark themes, workshop visits, social links, a protected contact form and an email-app option.",
        "ko": "한국어·영어와 밝은·어두운 테마로 운영합니다. 작업실 방문, 소셜 링크, 봇·반복 요청을 제한하는 문의 폼과 메일 앱 연결을 제공합니다."
      }
    },
    {
      "slug": "grench-boss",
      "thumbnail": {
        "src": "/uploads/b2945d801486f238473a.webp",
        "width": 640,
        "height": 360,
        "alt": {
          "en": "The goblin with a wrench beside a cannon and a crossbow as a horde of rats closes in",
          "ko": "대포와 석궁 옆에서 렌치를 든 고블린과 몰려오는 쥐 무리"
        },
        "caption": {
          "en": "Key art (in-game render)",
          "ko": "키 아트 (게임 화면 렌더)"
        }
      },
      "workerIds": [
        "frondward",
        "induo-works"
      ],
      "year": "2026",
      "stack": [
        "Godot",
        "GDScript",
        "GDExtension (C++)"
      ],
      "kind": "game",
      "status": "in-progress",
      "featured": true,
      "title": {
        "en": "GRENCH BOSS",
        "ko": "GRENCH BOSS"
      },
      "summary": {
        "en": "A defense game about a goblin boss, a crash landing and far too many rats.",
        "ko": "고블린 보스와 불시착, 그리고 지나치게 많은 쥐에 관한 디펜스 게임입니다."
      },
      "role": {
        "en": "Developed by Frondward, published by Induo Works",
        "ko": "개발 Frondward, 배급 Induo Works"
      },
      "challenge": {
        "en": "The rats want your airship. It's mostly scrap, but it's yours. Build walls, dig the ground out from under them, and jump in yourself when the walls don't hold. (They rarely hold.)",
        "ko": "쥐들이 당신의 비행선을 노립니다. 거의 고철이지만, 그래도 당신 것입니다. 벽을 세우고, 그 밑의 땅을 파내고, 벽이 버티지 못하면 직접 뛰어듭니다. (대체로 뚫립니다.)"
      },
      "approach": {
        "en": "Built in Godot with GDScript and C++ (GDExtension).",
        "ko": "Godot에서 GDScript와 C++(GDExtension)로 개발합니다."
      },
      "outcome": {
        "en": "A free demo is available on Steam. The full game is in development.",
        "ko": "Steam에서 무료 데모를 받을 수 있습니다. 정식판을 개발하고 있습니다."
      },
      "href": "/grench-boss/",
      "steamUrl": "https://store.steampowered.com/app/5154660/"
    },
