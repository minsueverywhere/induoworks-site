{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-20",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "induoworks-site",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [{
		"binding": "STUDIO_DB",
		"database_name": "induoworks-studio",
		"database_id": "1f0ce821-a441-4741-bdf8-12504edaa967",
		"migrations_dir": "migrations"
	}],
	"vars": {"DISCORD_CLIENT_ID": "1469603219695992895", "DISCORD_GUILD_ID":"1560135939290832990", "DISCORD_PUBLIC_KEY":"d350d50d10c179e7c0590ded9bbf196ade76d941a5d2cce7ac2dd1fff4bbac79"},
	"ratelimits": [{
		"name": "CONTACT_RATE_LIMITER",
		"namespace_id": "2026101601",
		"simple": { "limit": 5, "period": 60 }
	}, {
		"name": "STUDIO_RATE_LIMITER",
		"namespace_id": "2026101701",
		"simple": { "limit": 30, "period": 60 }
	}, {
		"name": "VISIT_RATE_LIMITER",
		"namespace_id": "2026101901",
		"simple": { "limit": 120, "period": 60 }
	}],
	"observability": {
		"enabled": true
	}
}
