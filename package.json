{
  "name": "induoworks",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run content:prepare && npm test && npm run check && astro build && node scripts/verify-build.mjs && node scripts/check-site-links.mjs",
    "test": "node --test scripts/*.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run generate-types && astro check",
    "worker:dev": "npm run build && wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "generate-types": "wrangler types",
    "content:prepare": "node scripts/content-prepare.mjs",
    "content:edit": "node scripts/editor-start.mjs",
    "content:import": "node scripts/content-prepare.mjs import",
    "content:deploy": "npm run content:prepare && wrangler deploy --config content/wrangler.jsonc",
    "check:links": "node scripts/check-site-links.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260815.1",
    "@playwright/test": "^1.56.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.124.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261012.1": true
  }
}
