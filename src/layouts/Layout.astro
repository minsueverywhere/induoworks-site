---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  noindex?: boolean;
}

const { lang, title, description, noindex } = Astro.props;
const dict = t(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <SEO lang={lang} title={title} description={description} noindex={noindex} />

    <!--
      Blocking, inline, and tiny on purpose: sets the theme before first paint
      so there is no flash of the wrong theme. Runs before any stylesheet.
    -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="skip-link focus-ring rounded bg-[var(--color-accent)] px-3 py-2 text-sm text-white">
      {dict.misc.skipToContent}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
