---
import '../styles/global.css';
import {ClientRouter} from 'astro:transitions';
import MusicPlayer from '../components/MusicPlayer.astro';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  noindex?: boolean;
  image?: string | null;
  imageAlt?: string;
}

const { lang, title, description, noindex, image, imageAlt } = Astro.props;
const dict = t(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" type="image/png" sizes="512x512" href="/brand/dewy-icon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <SEO lang={lang} title={title} description={description} noindex={noindex} image={image} imageAlt={imageAlt} />

    <!--
      Blocking, inline, and tiny on purpose: sets the theme before first paint
      so there is no flash of the wrong theme. Runs before any stylesheet.
    -->
    <script is:inline data-astro-rerun>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored === 'dark' ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <a href="#main" class="skip-link focus-ring rounded bg-[var(--color-accent)] px-3 py-2 text-sm text-[var(--color-bg)]">
      {dict.misc.skipToContent}
    </a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <MusicPlayer lang={lang} />
  </body>
</html>
