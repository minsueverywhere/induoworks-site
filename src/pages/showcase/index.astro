---
import Layout from '../../layouts/Layout.astro';
import { showcase } from '../../config';
---

<Layout title="Showcase" description="How this site is built: performance, accessibility, and security choices.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-16 sm:pt-20">
    <h1 class="text-3xl font-semibold tracking-tight">Engineering showcase</h1>
    <p class="mt-3 max-w-xl text-[var(--color-text-muted)]">
      This site is itself a demo — every choice below is live on the page you're reading.
    </p>

    <div class="mt-10 space-y-6">
      {showcase.map((item) => (
        <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 sm:p-8">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="font-semibold">{item.title}</h2>
          </div>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">{item.detail}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {item.tags.map((t) => (
              <li class="rounded-full border border-[var(--color-border)] px-2.5 py-1 text-xs text-[var(--color-text-muted)]">{t}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</Layout>
