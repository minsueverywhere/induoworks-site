---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<Layout title="Contact" description="Get in touch.">
  <section class="mx-auto max-w-xl px-6 pb-24 pt-16 sm:pt-20">
    <h1 class="text-3xl font-semibold tracking-tight">Contact</h1>
    <p class="mt-3 text-[var(--color-text-muted)]">
      {site.email
        ? `Prefer email? Write to ${site.email}. Otherwise, the form below reaches me directly.`
        : "Send a message below — it goes straight to me, no account or signup needed."}
    </p>

    <form id="contact-form" class="mt-10 space-y-5" novalidate>
      <div>
        <label for="name" class="block text-sm font-medium">Name</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          maxlength="120"
          autocomplete="name"
          class="focus-ring mt-1.5 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3.5 py-2.5 text-sm outline-none"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          maxlength="200"
          autocomplete="email"
          class="focus-ring mt-1.5 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3.5 py-2.5 text-sm outline-none"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium">Message</label>
        <textarea
          id="message"
          name="message"
          required
          minlength="10"
          maxlength="4000"
          rows="6"
          class="focus-ring mt-1.5 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3.5 py-2.5 text-sm outline-none"
        ></textarea>
      </div>

      <!-- Honeypot: hidden from real users, bots tend to fill every field -->
      <div class="hidden" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
      )}

      <button
        id="submit-btn"
        type="submit"
        class="focus-ring w-full rounded-full bg-[var(--color-text)] px-5 py-2.5 text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90 disabled:opacity-50"
      >
        Send message
      </button>

      <p id="form-status" role="status" aria-live="polite" class="text-sm"></p>
    </form>
  </section>

  {turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const status = document.getElementById('form-status') as HTMLParagraphElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const body = await res.json().catch(() => ({}));

        if (!res.ok) {
          throw new Error(body?.error || 'Something went wrong. Please try again.');
        }

        form.reset();
        status.textContent = "Sent — thanks, I'll get back to you soon.";
        status.className = 'text-sm text-[var(--color-accent)]';
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : 'Something went wrong.';
        status.className = 'text-sm text-red-400';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send message';
      }
    });
  </script>
</Layout>
