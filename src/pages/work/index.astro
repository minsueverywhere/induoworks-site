---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../config';
---

<Layout title="Work" description="Selected projects and case studies.">
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-16 sm:pt-20">
    <h1 class="text-3xl font-semibold tracking-tight">Work</h1>
    <p class="mt-3 max-w-xl text-[var(--color-text-muted)]">Selected projects, with what shipped and why.</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {projects.map((p) => (
        <a
          href={`/work/${p.slug}/`}
          class="focus-ring group rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 transition-colors hover:border-[var(--color-accent)]"
        >
          <div class="flex items-center justify-between">
            <h2 class="font-semibold">{p.title}</h2>
            <span class="text-xs text-[var(--color-text-muted)]">{p.year}</span>
          </div>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">{p.summary}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {p.stack.map((s) => (
              <li class="rounded-full border border-[var(--color-border)] px-2.5 py-1 text-xs text-[var(--color-text-muted)]">{s}</li>
            ))}
          </ul>
        </a>
      ))}
    </div>
  </section>
</Layout>
