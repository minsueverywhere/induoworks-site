---
import { socialLinks } from '../config';
import { localizePath, type Locale } from '../i18n';
interface Props { lang: Locale; }
const { lang } = Astro.props;
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-identity">
        <nav class="footer-links" aria-label={lang==='ko'?'사이트 안내':'Site information'}>
          <a href={localizePath('/showcase/',lang)} class="focus-ring" aria-label="About this site" title="About this site"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v6m0-10h.01" /></svg></a>
          <a href={localizePath('/contact/',lang)} class="focus-ring" aria-label="Contact" title="Contact"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3 6 9 7 9-7" /></svg></a>
        </nav>
      </div>
      <nav aria-label="Social media" class="footer-social">
        {socialLinks.map(social=><a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={social.name} title={social.name} class="focus-ring"><img src={'/social/'+social.icon+'.svg'} width="21" height="21" alt="" class="social-icon" /></a>)}
      </nav>
    </div>
  </div>
</footer>
<style>
  .site-footer { flex-shrink:0;margin-top:var(--section-gap);border-top:1px solid var(--color-border); }
  .footer-inner { max-width:64rem;margin:0 auto;padding:var(--section-gap) 1.5rem; }
  .footer-top { display:flex;align-items:center;justify-content:space-between;gap:var(--section-gap);flex-wrap:wrap; }
  .footer-identity { display:flex;align-items:center;gap:.5rem; }
  .footer-links,.footer-social { display:flex;align-items:center;gap:.25rem; }
  .footer-links a,.footer-social a { position:relative;display:inline-flex;width:24px;height:14px;align-items:center;justify-content:center;color:var(--color-text-muted); }
  .footer-links a::before,.footer-social a::before { content:'';position:absolute;inset:-6px 0; }
  .footer-links svg { width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round; }
  .footer-social a { width:28px; }
  .social-icon { width:14px;height:14px;opacity:.85; }
  :global([data-theme="dark"]) .social-icon { filter:invert(1); }
  @media(max-width:639px) {
    .footer-top { gap:var(--section-gap) .5rem; }
    .footer-identity { gap:.25rem; }
    .footer-links { gap:0; }.footer-links a{width:20px;}
    .footer-social { flex-wrap:nowrap;gap:0; }
    .footer-social a { width:20px; }
  }
  @media(max-width:479px) { .footer-top{flex-wrap:nowrap} }
</style>
