---
import { site } from '../config';
import { t, navItems, localizePath, stripLocale, type Locale } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
const otherLang: Locale = lang === 'en' ? 'ko' : 'en';

const { path: currentBasePath } = stripLocale(Astro.url.pathname);
const isActive = (basePath: string) =>
  basePath === '/' ? currentBasePath === '/' : currentBasePath.startsWith(basePath);

const items = navItems.map((item) => ({
  href: localizePath(item.path, lang),
  label: dict.nav[item.key],
  active: isActive(item.path),
}));

const switchHref = localizePath(currentBasePath, otherLang);
---

<header class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-bg)]/80 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={localizePath('/', lang)} class="focus-ring rounded font-semibold tracking-tight">
      {site.name}
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={[
            'focus-ring rounded text-sm transition-colors',
            item.active
              ? 'text-[var(--color-text)]'
              : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
          ]}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={switchHref}
        class="focus-ring rounded-full border border-[var(--color-border)] px-3 py-1.5 text-xs font-medium text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text)]"
        aria-label={dict.misc.switchLangLabel}
        hreflang={otherLang}
      >
        {dict.misc.switchLangShort}
      </a>
      <ThemeToggle lang={lang} />
      <button
        id="menu-toggle"
        type="button"
        aria-label={dict.misc.toggleMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="focus-ring inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] md:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4.5 w-4.5">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-[var(--color-border)] px-6 py-3 md:hidden" aria-label="Primary mobile">
    <ul class="flex flex-col gap-3">
      {items.map((item) => (
        <li>
          <a href={item.href} class="focus-ring block rounded text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href={switchHref} hreflang={otherLang} class="focus-ring block rounded text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
          {dict.misc.switchLangShort}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      const isHidden = menu?.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isHidden));
    });
  })();
</script>
