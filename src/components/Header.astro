---
import { site } from '../config';
import { t, navItems, locales, localeNames, localizePath, stripLocale, type Locale } from '../i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);

const { path: currentBasePath } = stripLocale(Astro.url.pathname);
const isActive = (basePath: string) =>
  basePath === '/' ? currentBasePath === '/' :
  currentBasePath.startsWith(basePath) || (basePath === '/work/' && currentBasePath.startsWith('/labs/'));

const items = navItems.map((item) => ({
  href: localizePath(item.path, lang),
  label: dict.nav[item.key],
  active: isActive(item.path),
}));

const languagePath = currentBasePath === '/404/' ? '/' : currentBasePath;
---

<header class="border-b border-[var(--color-border)] bg-[var(--color-bg)]">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a href={localizePath('/', lang)} aria-label={site.name} class="focus-ring flex items-center gap-2.5 rounded font-semibold tracking-tight">
      <img src="/brand/dewy-profile.png" width="36" height="36" class="brand-mark h-9 w-9 rounded-full" alt="" />
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    <nav id="primary-nav" class="desktop-nav hidden items-center gap-6 lg:flex" aria-label="Primary">
      {items.map((item) => (
        <a
          href={item.href}
          class:list={[
            'focus-ring rounded text-sm transition-colors',
            item.active
              ? 'text-[var(--color-accent)]'
              : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)]',
          ]}
          aria-current={item.active ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>

    <div class="flex items-center gap-2">
      <select id="site-language" aria-label={lang === 'ko' ? '언어' : 'Language'} class="focus-ring h-9 rounded border border-[var(--color-border)] bg-[var(--color-bg)] px-2 text-xs text-[var(--color-text)]">
        {locales.map((locale) => (
          <option value={localizePath(languagePath, locale)} lang={locale} selected={locale === lang}>{localeNames[locale]}</option>
        ))}
      </select>
      <ThemeToggle lang={lang} />
      <button
        id="menu-toggle"
        type="button"
        aria-label={dict.misc.toggleMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="focus-ring inline-flex h-9 w-9 items-center justify-center rounded-full border border-[var(--color-border)] text-[var(--color-text-muted)] lg:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-4.5 w-4.5">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-6 py-4 lg:hidden" aria-label="Primary mobile">
    <ul class="flex flex-col gap-3">
      {items.map((item) => (
        <li>
          <a href={item.href} aria-current={item.active ? 'page' : undefined} class="focus-ring block rounded text-sm text-[var(--color-text-muted)] hover:text-[var(--color-text)]">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    btn?.addEventListener('click', () => {
      const isHidden = menu?.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(!isHidden));
    });

    const language = document.getElementById('site-language');
    language?.addEventListener('change', () => window.location.assign(language.value));

    const nav = document.getElementById('primary-nav');
    const indicator = nav?.querySelector('.nav-indicator');
    if (!nav || !indicator) return;
    function place(link, offset = 0) {
      if (!link) { indicator.style.opacity = '0'; return; }
      const rect = link.getBoundingClientRect();
      const parent = nav.getBoundingClientRect();
      indicator.style.width = rect.width + 'px';
      indicator.style.transform = 'translateX(' + (rect.left - parent.left + offset) + 'px)';
      indicator.style.opacity = '1';
    }
    function restore() { place(nav.querySelector('a:focus-visible') || nav.querySelector('[aria-current="page"]')); }
    nav.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      const link = event.target.closest('a');
      if (!link) return;
      const rect = link.getBoundingClientRect();
      const offset = rect.width ? ((event.clientX - rect.left) / rect.width - .5) * 6 : 0;
      place(link, offset);
    });
    nav.addEventListener('pointerleave', restore);
    nav.addEventListener('focusin', (event) => place(event.target.closest('a')));
    nav.addEventListener('focusout', (event) => { if (!nav.contains(event.relatedTarget)) restore(); });
    new ResizeObserver(restore).observe(nav);
    restore();
  })();
</script>

<style>
  .desktop-nav { position: relative; padding-block: .65rem; }
  .nav-indicator { position: absolute; bottom: 0; left: 0; height: 1px; background: var(--color-text); pointer-events: none; opacity: 0; transition: transform 180ms ease, width 180ms ease, opacity 180ms ease; }
  .nav-indicator::after { content: ''; position: absolute; right: 0; top: -1.5px; width: 4px; height: 4px; background: currentColor; }
  @media (prefers-reduced-motion: reduce) { .nav-indicator { transition: none; } }
</style>
