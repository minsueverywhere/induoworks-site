---
import { site } from '../config';
import { t, locales, localizePath, stripLocale, type Locale } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  noindex?: boolean;
  /** Omit for the site-wide card; pass null for pages that must not inherit it. */
  image?: string | null;
  imageAlt?: string;
}

const { lang, title, description, noindex = false, image = '/og.png', imageAlt } = Astro.props;
const dict = t(lang);
const finalDescription = description ?? dict.meta.description;
const pageTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonicalURL = new URL(Astro.url.pathname, site.url);
const imageURL = image === null ? undefined : new URL(image, site.url);

// hreflang alternates: same page, every locale, so search engines know these
// are translations of each other rather than duplicate content.
const { path: basePath } = stripLocale(Astro.url.pathname);
const alternates = locales.map((l) => ({
  lang: l,
  href: new URL(localizePath(basePath, l), site.url).toString(),
}));
---

<title>{pageTitle}</title>
<meta name="description" content={finalDescription} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={new URL(basePath, site.url).toString()} />

<meta property="og:type" content="website" />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={finalDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
{imageURL && <meta property="og:image" content={imageURL} />}
{imageURL && <meta property="og:image:alt" content={imageAlt ?? pageTitle} />}

<meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={finalDescription} />
{imageURL && <meta name="twitter:image" content={imageURL} />}
{imageURL && <meta name="twitter:image:alt" content={imageAlt ?? pageTitle} />}
