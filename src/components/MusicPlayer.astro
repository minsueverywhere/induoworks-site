---
import type {Locale} from '../i18n';
interface Props {lang:Locale}
const {lang}=Astro.props;
---
<aside id="site-music" transition:persist="site-music" aria-label={lang==='ko'?'음악 플레이어':'Music player'} hidden>
  <div class="site-music-row">
    <button id="site-music-handle" class="music-toggle" type="button" aria-label="Play"></button>
    <div id="site-music-track" role="slider" tabindex="0" aria-valuemin="0" aria-valuemax="1" aria-valuenow="0"><span id="site-music-work" class="site-music-marquee"><span></span></span><span id="site-music-time" aria-hidden="true"></span></div>
  </div>
  <span id="site-music-status" class="sr-only" role="status"></span>
</aside>
<script>import '../scripts/site-music-ui.js';</script>
<style>
  #site-music{position:fixed;z-index:1100;bottom:max(10px,env(safe-area-inset-bottom));left:50%;transform:translateX(-50%);width:min(200px,calc(100% - 20px));background:var(--color-bg);color:var(--color-text-muted);border:1px solid var(--color-border);font:12px/1.5 system-ui,sans-serif;box-sizing:border-box;transition:background-color .12s,border-color .12s,box-shadow .12s}
  #site-music[hidden]{display:none}
  .site-music-row{display:flex;align-items:center}
  button{flex:none;width:32px;height:40px;padding:0;border:0;background:transparent;color:inherit;font:inherit;cursor:pointer;display:grid;place-items:center}
  button:active{color:var(--color-text);background:var(--color-bg-elevated)}
  svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;pointer-events:none}
  /* One button: press to play or pause, drag to move or tuck against an edge. */
  #site-music-handle{width:36px;cursor:grab;touch-action:none;color:var(--color-text);background:var(--color-bg-elevated)}#site-music-handle:active{cursor:grabbing}
  #site-music[data-dock]{height:40px;overflow:hidden;border:0;background:transparent}
  #site-music[data-dock] #site-music-handle{box-sizing:border-box;border:1px solid var(--color-border);background:var(--color-bg-elevated)}
  #site-music[data-dock="left"] #site-music-handle{order:4}
  #site-music[data-dock] #site-music-track{visibility:hidden;pointer-events:none}
  /* The title scrolls when it is too long instead of widening the player. */
  .site-music-marquee{flex:1;min-width:0;display:block;overflow:hidden;white-space:nowrap;pointer-events:none}
  .site-music-marquee span{display:inline-block}
  .site-music-marquee[data-overflow=true] span{animation:site-music-marquee var(--marquee-time) linear infinite}
  @keyframes site-music-marquee{0%,12%{transform:none}88%,100%{transform:translateX(var(--marquee-shift))}}
  @media(prefers-reduced-motion:reduce){.site-music-marquee[data-overflow=true] span{animation:none}}
  /* The title doubles as the progress bar: it fills as the track plays and seeks where pressed. */
  #site-music-track{flex:1;min-width:0;align-self:stretch;display:flex;align-items:center;padding:0 8px;cursor:pointer;touch-action:none;--fill:11%;background:linear-gradient(to right,color-mix(in srgb,var(--color-accent) var(--fill),transparent) var(--progress,0%),transparent var(--progress,0%))}
  /* Pressing deepens the fill and swaps the title for the chosen position. */
  #site-music[data-seeking] #site-music-track{--fill:22%}
  #site-music-time{display:none;margin-left:auto;font-variant-numeric:tabular-nums;white-space:nowrap}
  #site-music[data-seeking] #site-music-time{display:block}#site-music[data-seeking] .site-music-marquee{display:none}
  #site-music-handle::before{border-top-width:6px;border-bottom-width:6px;border-left-width:10px}
  #site-music-handle[aria-pressed="true"]::before{width:10px;height:12px;border-top:0;border-bottom:0;border-left-width:3px;border-right-width:3px}
  #site-music-handle[data-loading="true"]::before{border:0}
  #site-music[data-dragging="true"]{background:var(--color-bg-elevated);background:color-mix(in srgb,var(--color-accent) 18%,var(--color-bg));color:var(--color-text);border-color:var(--color-accent);box-shadow:0 3px 14px #0002;user-select:none}
  #site-music[data-dragging="true"][data-dock] #site-music-handle{background:var(--color-bg-elevated);border-color:var(--color-accent)}
  #site-music[data-drop] #site-music-handle{color:var(--color-accent);background:var(--color-bg-elevated)}
  #site-music[data-drop]::after{content:'';position:fixed;top:0;bottom:0;width:4px;background:var(--color-accent);opacity:.4;pointer-events:none;box-shadow:0 0 16px var(--color-accent)}
  #site-music[data-drop="left"]::after{left:0}#site-music[data-drop="right"]::after{right:0}
  button:focus-visible,#site-music-track:focus-visible{outline:1px solid currentColor;outline-offset:-3px}
</style>
