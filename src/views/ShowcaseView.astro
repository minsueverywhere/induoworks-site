---
import Layout from '../layouts/Layout.astro';
import { showcase } from '../config';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
---

<Layout lang={lang} title={dict.showcase.title} description={dict.showcase.description}>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-16 sm:pt-20">
    <h1 class="text-3xl font-semibold tracking-tight">{dict.showcase.heading}</h1>
    <p class="mt-3 max-w-xl text-[var(--color-text-muted)]">
      {dict.showcase.intro}
    </p>

    <div class="mt-10 space-y-6">
      {showcase.map((item) => (
        <div class="workshop-panel wood-rule rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 pl-7 sm:p-8 sm:pl-9">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="font-semibold">{item.title[lang]}</h2>
          </div>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">{item.detail[lang]}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {item.tags.map((t) => (
              <li class="rounded-full border border-[var(--color-border)] px-2.5 py-1 text-xs text-[var(--color-text-muted)]">{t}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-10 max-w-xl text-xs leading-relaxed text-[var(--color-text-muted)]">
      {lang==='ko'
        ? '방문 집계: 이 사이트는 브라우저에 무작위 기기 ID를 하나 저장하고, 페이지를 열 때 그 ID의 해시와 날짜만 기록해 방문·기기 수를 셉니다. 이름·IP·쿠키 정보는 기록하지 않으며, 사이트 데이터를 지우면 ID도 지워집니다. Cloudflare Web Analytics의 쿠키 없는 집계도 사용합니다.'
        : 'Visit counts: this site keeps one random device ID in your browser and, when a page opens, records only a hash of that ID and the date to count visits and devices. No names, IP addresses or cookies are stored, and clearing site data removes the ID. Cookie-free Cloudflare Web Analytics is also used.'}
    </p>
  </section>
</Layout>
