---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

const strings = {
  sending: dict.contact.sending,
  sentOk: dict.contact.sentOk,
  genericError: dict.contact.genericError,
  send: dict.contact.send,
};
---

<Layout lang={lang} title={dict.contact.title} description={dict.contact.title}>
  <section class="mx-auto max-w-xl px-6 pb-24 pt-16 sm:pt-20">
    <p class="technical-label text-[var(--color-wood)]">INBOX / DIRECT LINE</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">{dict.contact.title}</h1>
    <p class="mt-3 text-[var(--color-text-muted)]">
      {site.email ? dict.contact.introWithEmail(site.email) : dict.contact.introNoEmail}
    </p>

    <form id="contact-form" class="workshop-panel mt-10 space-y-5 rounded-xl border border-[var(--color-border)] p-6 sm:p-8" novalidate>
      <div>
        <label for="name" class="block text-sm font-medium">{dict.contact.name}</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          maxlength="120"
          autocomplete="name"
          class="focus-ring mt-1.5 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3.5 py-2.5 text-sm outline-none"
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium">{dict.contact.email}</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          maxlength="200"
          autocomplete="email"
          class="focus-ring mt-1.5 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3.5 py-2.5 text-sm outline-none"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium">{dict.contact.message}</label>
        <textarea
          id="message"
          name="message"
          required
          minlength="10"
          maxlength="4000"
          rows="6"
          class="focus-ring mt-1.5 w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-elevated)] px-3.5 py-2.5 text-sm outline-none"
        ></textarea>
      </div>

      <!-- Honeypot: hidden from real users, bots tend to fill every field -->
      <div class="hidden" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {turnstileSiteKey && (
        <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
      )}

      <button
        id="submit-btn"
        type="submit"
        class="focus-ring w-full rounded-full bg-[var(--color-text)] px-5 py-2.5 text-sm font-medium text-[var(--color-bg)] transition-opacity hover:opacity-90 disabled:opacity-50"
      >
        {dict.contact.send}
      </button>

      <p class="text-xs leading-relaxed text-[var(--color-text-muted)]">{dict.contact.privacyNote}</p>

      <p id="form-status" role="status" aria-live="polite" class="text-sm"></p>
    </form>
  </section>

  {turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )}

  <script is:inline define:vars={{ strings }}>
    const form = document.getElementById('contact-form');
    const status = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.textContent = '';
      if (!form.reportValidity()) return;
      submitBtn.disabled = true;
      submitBtn.textContent = strings.sending;

      const data = Object.fromEntries(new FormData(form).entries());

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        await res.json().catch(() => ({}));

        if (!res.ok) {
          throw new Error(strings.genericError);
        }

        form.reset();
        status.textContent = strings.sentOk;
        status.className = 'text-sm text-[var(--color-accent)]';
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : strings.genericError;
        status.className = 'text-sm text-red-400';
      } finally {
        // Turnstile tokens are single-use. Always request a fresh token so a
        // visitor can retry after a validation or email-provider failure.
        // @ts-expect-error Turnstile adds this global when its script loads.
        window.turnstile?.reset();
        submitBtn.disabled = false;
        submitBtn.textContent = strings.send;
      }
    });
  </script>
</Layout>
