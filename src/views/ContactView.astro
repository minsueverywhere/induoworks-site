---
import Layout from '../layouts/Layout.astro';
import { site } from '../config';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

const strings = {
  sending: dict.contact.sending,
  sentOk: dict.contact.sentOk,
  genericError: dict.contact.genericError,
  send: dict.contact.send,
  verificationPending: dict.contact.verificationPending,
  verificationExpired: dict.contact.verificationExpired,
  verificationError: dict.contact.verificationError,
  unavailableError: dict.contact.unavailableError,
  rateLimitedError: dict.contact.rateLimitedError,
  validationError: dict.contact.validationError,
};
---

<Layout lang={lang} title={dict.contact.title} description={dict.contact.title}>
  <section class="page-main">
    
    <h1 class="page-title">{dict.contact.title}</h1>
    <p class="page-intro">
      {dict.contact.introNoEmail}
    </p>
    {site.email && <p class="contact-email"><a href={'mailto:'+site.email}>{dict.contact.openMailApp} ↗</a><span>{site.email}</span></p>}

    <form id="contact-form" data-strings={JSON.stringify(strings)} class="contact-form" data-verification={turnstileSiteKey ? 'required' : 'none'} novalidate>
      <div class="contact-identity">
      <div>
        <label for="name">{dict.contact.name}</label>
        <input
          id="name"
          name="name"
          type="text"
          required
          maxlength="120"
          autocomplete="name"
        />
      </div>

      <div>
        <label for="email">{dict.contact.email}</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          maxlength="200"
          autocomplete="email"
        />
      </div>
      </div>

      <div>
        <label for="message">{dict.contact.message}</label>
        <textarea
          id="message"
          name="message"
          required
          minlength="10"
          maxlength="4000"
          rows="7"
          aria-describedby="message-hint"
        ></textarea>
        <p id="message-hint" class="contact-note">{dict.contact.messageHint}</p>
      </div>

      <!-- Honeypot: hidden from real users, bots tend to fill every field -->
      <div class="hidden" aria-hidden="true">
        <label for="company">Company</label>
        <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      {turnstileSiteKey && (
        <div id="contact-turnstile" class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto" data-size="compact" data-appearance="interaction-only" data-callback="contactVerified" data-expired-callback="contactVerificationExpired" data-error-callback="contactVerificationFailed"></div>
        <p id="verification-status" class="contact-note" role="status">{dict.contact.verificationPending}</p>
      )}

      <div class="contact-actions">
      <p class="contact-note">{dict.contact.privacyNote}</p>
      <button
        id="submit-btn"
        type="submit"
        disabled={!!turnstileSiteKey}
      >
        {dict.contact.send}
      </button>
      </div>

      <p id="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <script is:inline data-astro-rerun>
  (()=>{
    const form = document.getElementById('contact-form');
    const strings=JSON.parse(form.dataset.strings);
    const status = document.getElementById('form-status');
    const submitBtn = document.getElementById('submit-btn');
    const verification = document.getElementById('verification-status');
    const requiresVerification = form.dataset.verification === 'required';
    let verified = !requiresVerification, sending = false;
    function setVerification(ready, message = '') {
      verified = ready;
      submitBtn.disabled = sending || !verified;
      if (verification) { verification.textContent = message; verification.hidden = !message; }
    }
    window.contactVerified = () => setVerification(true);
    window.contactVerificationExpired = () => setVerification(false, strings.verificationExpired);
    window.contactVerificationFailed = () => setVerification(false, strings.verificationError);

    window.contactTurnstileReady=()=>{
      const widget=document.getElementById('contact-turnstile');
      if(widget&&!widget.dataset.widget&&window.turnstile?.render)widget.dataset.widget=window.turnstile.render(widget,{sitekey:widget.dataset.sitekey,theme:'auto',size:'compact',appearance:'interaction-only',callback:window.contactVerified,'expired-callback':window.contactVerificationExpired,'error-callback':window.contactVerificationFailed});
    };
    window.contactTurnstileReady();
    document.addEventListener('astro:before-swap',()=>{const widget=document.getElementById('contact-turnstile');if(widget?.dataset.widget)window.turnstile?.remove?.(widget.dataset.widget);},{once:true});
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      status.textContent = '';
      delete status.dataset.state;
      if (!form.reportValidity()) return;
      const data = Object.fromEntries(new FormData(form).entries());
      if (!verified || (requiresVerification && !data['cf-turnstile-response'])) {
        setVerification(false, strings.verificationPending);
        return;
      }
      sending = true;
      submitBtn.disabled = true;
      submitBtn.textContent = strings.sending;

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await res.json().catch(() => ({}));

        if (!res.ok || result.ok !== true) {
          if (res.status === 429) throw new Error(strings.rateLimitedError);
          const errors = { validation: strings.validationError, verification: strings.verificationError, unavailable: strings.unavailableError };
          throw new Error(errors[result.code] || strings.genericError);
        }

        form.reset();
        status.textContent = strings.sentOk;
        status.dataset.state = 'success';
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : strings.genericError;
        status.dataset.state = 'error';
      } finally {
        // Turnstile tokens are single-use. Always request a fresh token so a
        // visitor can retry after a validation or email-provider failure.
        // @ts-expect-error Turnstile adds this global when its script loads.
        window.turnstile?.reset();
        sending = false;
        setVerification(!requiresVerification, requiresVerification ? strings.verificationPending : '');
        submitBtn.textContent = strings.send;
      }
    });
  })();
  </script>
  {turnstileSiteKey && (
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=contactTurnstileReady&amp;render=explicit" async defer></script>
  )}
</Layout>

<style>
  .contact-email { display: flex; flex-wrap: wrap; align-items: center; gap: .25rem .75rem; margin-top: .5rem; font-size: .8rem; color: var(--color-text-muted); }
  .contact-email a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-text); text-decoration: underline; text-underline-offset: 4px; }
  .contact-form { max-width: 46rem; margin-top: 2.5rem; display: grid; gap: 1.5rem; }
  .contact-identity { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1.5rem; }
  label { display: block; margin-bottom: .6rem; font-size: .8rem; font-weight: 500; }
  input,textarea { width: 100%; min-height: 48px; border: 1px solid var(--color-border); border-radius: .25rem; padding: .75rem; background: transparent; color: var(--color-text); font: inherit; font-size: 1rem; }
  textarea { display: block; resize: vertical; line-height: 1.75; }
  input:focus-visible,textarea:focus-visible,button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }
  .contact-note { font-size: .75rem; line-height: 1.7; color: var(--color-text-muted); }
  #message-hint { margin-top: .5rem; }
  .contact-actions { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding-top: .25rem; }
  .contact-actions p { max-width: 27rem; }
  button { flex-shrink: 0; min-height: 44px; padding: .75rem 1.5rem; border: 1px solid var(--color-text); border-radius: .25rem; background: var(--color-text); color: var(--color-bg); font-size: .875rem; cursor: pointer; }
  button:hover { opacity: .85; }
  button:disabled { opacity: .5; cursor: wait; }
  #form-status { min-height: 1.5rem; font-size: .875rem; line-height: 1.7; }
  #form-status[data-state="success"] { color: var(--color-accent); }
  #form-status[data-state="error"] { color: var(--color-error); }
  @media(max-width:639px) { .contact-identity { grid-template-columns: minmax(0,1fr); } .contact-actions { align-items: start; flex-direction: column-reverse; gap: 1rem; } .contact-actions button { width: 100%; } }
</style>
