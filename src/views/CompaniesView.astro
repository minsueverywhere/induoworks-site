---
import Layout from '../layouts/Layout.astro';
import { companies } from '../config';
import { t, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
const visibleCompanies = companies.filter((company) => company.published !== false);
---

<Layout lang={lang} title={dict.companies.title} description={dict.companies.description} noindex={visibleCompanies.length === 0}>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-16 sm:pt-20">
    <p class="technical-label text-[var(--color-wood)]">GROUP / DIRECTORY</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">{dict.companies.heading}</h1>
    <p class="mt-3 max-w-xl text-[var(--color-text-muted)]">
      {dict.companies.intro}
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {visibleCompanies.map((c) => (
        <div class="workshop-panel wood-rule rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 pl-7 sm:p-8 sm:pl-9">
          <div class="flex items-center gap-4">
            {c.logo ? (
              <img src={c.logo} alt={`${c.name} logo`} class="h-12 w-12 rounded-xl object-contain" width="48" height="48" />
            ) : (
              <div
                class="flex h-12 w-12 items-center justify-center rounded-xl border border-[var(--color-border)] text-base font-semibold text-[var(--color-text-muted)]"
                aria-hidden="true"
              >
                {c.name.charAt(0)}
              </div>
            )}
            <h2 class="text-lg font-semibold">{c.name}</h2>
          </div>
          <p class="mt-4 text-sm text-[var(--color-text-muted)]">{c.tagline[lang]}</p>
          {c.href && (
            <a
              href={c.href}
              target="_blank"
              rel="noopener noreferrer"
              class="focus-ring mt-5 inline-flex items-center gap-2 rounded-full border border-[var(--color-border)] px-4 py-2 text-sm hover:border-[var(--color-accent)]"
            >
              {dict.companies.visitSite}
            </a>
          )}
        </div>
      ))}
      {visibleCompanies.length === 0 && (
        <p class="text-sm text-[var(--color-text-muted)]">{dict.companies.empty}</p>
      )}
    </div>
  </section>
</Layout>
