---
import Layout from '../layouts/Layout.astro';
import { labs } from '../config';
import { t, localizePath, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
---

<Layout lang={lang} title={dict.labs.title} description={dict.labs.description}>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-16 sm:pt-20">
    <p class="technical-label text-[var(--color-wood)]">R&amp;D / OPEN BENCH</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">{dict.labs.title}</h1>
    <p class="mt-3 max-w-xl text-[var(--color-text-muted)]">{dict.labs.intro}</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {labs.map((lab, index) => (
        <a
          href={localizePath(`/labs/${lab.slug}/`, lang)}
          class="workshop-panel wood-rule focus-ring group rounded-xl border border-[var(--color-border)] p-6 pl-7 transition-colors hover:border-[var(--color-accent)]"
        >
          <div class="flex items-center justify-between gap-4">
            <span class="technical-label text-[var(--color-accent)]">EXP-{String(index + 1).padStart(2, '0')}</span>
            <span class="font-mono text-xs text-[var(--color-text-muted)]">{lab.year}</span>
          </div>
          <h2 class="mt-5 text-xl font-semibold">{lab.title[lang]}</h2>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{lab.summary[lang]}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {lab.stack.map((item) => <li class="rounded-full border border-[var(--color-border)] px-2.5 py-1 font-mono text-xs text-[var(--color-text-muted)]">{item}</li>)}
          </ul>
          <p class="mt-6 text-sm text-[var(--color-accent)]">{dict.labs.open}</p>
        </a>
      ))}
    </div>
  </section>
</Layout>
