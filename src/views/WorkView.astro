---
import Layout from '../layouts/Layout.astro';
import { projects } from '../config';
import { t, localizePath, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
---

<Layout lang={lang} title={dict.work.title} description={dict.work.description}>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-16 sm:pt-20">
    <h1 class="text-3xl font-semibold tracking-tight">{dict.work.title}</h1>
    <p class="mt-3 max-w-xl text-[var(--color-text-muted)]">{dict.work.intro}</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {projects.map((p) => (
        <a
          href={localizePath(`/work/${p.slug}/`, lang)}
          class="workshop-panel wood-rule focus-ring group rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-elevated)] p-6 pl-7 transition-colors hover:border-[var(--color-accent)]"
        >
          <div class="flex items-center justify-between">
            <h2 class="font-semibold">{p.title[lang]}</h2>
            <span class="text-xs text-[var(--color-text-muted)]">{p.year}</span>
          </div>
          <p class="mt-2 text-sm text-[var(--color-text-muted)]">{p.summary[lang]}</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {p.stack.map((s) => (
              <li class="rounded-full border border-[var(--color-border)] px-2.5 py-1 text-xs text-[var(--color-text-muted)]">{s}</li>
            ))}
          </ul>
        </a>
      ))}
    </div>
  </section>
</Layout>
