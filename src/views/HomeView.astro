---
import Layout from '../layouts/Layout.astro';
import Village from '../components/Village.astro';
import { site } from '../config';
import { t, type Locale } from '../i18n';
interface Props { lang: Locale; }
const { lang } = Astro.props;
const dict = t(lang);
---
<Layout lang={lang} title={site.name} description={dict.meta.description}>
  <Village lang={lang} />
</Layout>
