---
import Layout from '../layouts/Layout.astro';
import { t, localizePath, type Locale } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const dict = t(lang);
---

<Layout lang={lang} title={dict.notFound.title} noindex>
  <section class="mx-auto flex max-w-xl flex-col items-start px-6 py-32 text-left">
    <p class="text-sm font-medium text-[var(--color-accent)]">{dict.notFound.eyebrow}</p>
    <h1 class="mt-3 text-2xl font-semibold tracking-tight">{dict.notFound.title}</h1>
    <p class="mt-3 text-[var(--color-text-muted)]">{dict.notFound.body}</p>
    <a href={localizePath('/', lang)} class="focus-ring mt-6 rounded-full bg-[var(--color-text)] px-5 py-2.5 text-sm font-medium text-[var(--color-bg)] hover:opacity-90">
      {dict.notFound.back}
    </a>
  </section>
</Layout>
